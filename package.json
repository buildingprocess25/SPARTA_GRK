{
  "name": "alfamart-sustainability-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "daemon": "node scripts/solar-daemon.mjs",
    "sync:once": "node scripts/sync-once.mjs",
    "import:isolar-history": "node --env-file=.env scripts/import-isolar-monthly-history.mjs",
    "import:rkap-targets": "node --env-file=.env scripts/import-rkap-targets.mjs",
    "verify:plts-lock": "node scripts/verify-plts-overview-lock.mjs",
    "test": "node scripts/run-unit-tests.mjs",
    "test:db:isolated": "node scripts/run-isolated-db-tests.mjs",
    "test:data:readonly": "node scripts/run-readonly-tests.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:stabilization": "node scripts/test-stabilization.mjs",
    "test:inverter-temp": "node --test src/lib/solar/__tests__/inverterTemperature.test.mjs && node scripts/run-inverter-temperature-test-isolated.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.460.0",
    "next": "^15.3.0",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "puppeteer": "^25.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
