# PostgreSQL connection used by Prisma (server only)
DATABASE_URL=

# iSolarCloud server integration
ISOLAR_MODE=mock
ISOLAR_BASE_URL=https://gateway.isolarcloud.com.hk
ISOLAR_APP_KEY=
ISOLAR_SECRET_KEY=
ISOLAR_USER_ACCOUNT=
ISOLAR_USER_PASSWORD=

# Server-to-server scheduler authorization
CRON_SECRET=

# Telemetry older than this value is reported as STALE
ISOLAR_STALE_AFTER_MINUTES=15

# Optional: permit read-triggered sync in live mode
SYNC_FALLBACK_ON_READ=false

