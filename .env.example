# ==============================================================================
# SPARTA ESG & PLTS Dashboard - Environment Variables Template
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env` di server atau masukkan di menu Environment Dokploy.
# 2. Jangan pernah menyimpan file kredensial rahasia (.env) ke Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CORE (Wajib diisi di Dokploy Runtime)
# ------------------------------------------------------------------------------
# Lingkungan runtime aplikasi: production | development
NODE_ENV=production

# Zona Waktu Server (Wajib Asia/Jakarta agar jam WIB, slot 15/30 menit, dan reset kuota tepat)
TZ=Asia/Jakarta

# Port dan Host HTTP Server
PORT=3001
HOSTNAME=0.0.0.0

# Nonaktifkan telemetri anonim Next.js
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 2. DATABASE POSTGRESQL (Runtime)
# ------------------------------------------------------------------------------
# URL koneksi PostgreSQL yang digunakan oleh Prisma ORM
# Contoh: postgresql://postgres:password@db_host:5432/sparta_db?schema=public
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. iSOLARCLOUD OPENAPI GATEWAY (Runtime)
# ------------------------------------------------------------------------------
# Mode operasi: live (koneksi riil ke iSolar) | mock (simulasi offline)
ISOLAR_MODE=live

# URL Gateway iSolarCloud Sungrow
ISOLAR_BASE_URL=https://gateway.isolarcloud.com.hk

# Kredensial OpenAPI iSolarCloud (Diberikan oleh tim Sungrow/iSolar)
ISOLAR_APP_KEY=
ISOLAR_SECRET_KEY=
ISOLAR_USER_ACCOUNT=
ISOLAR_USER_PASSWORD=

# Batas usia telemetri sebelum diberi label STALE / Data Lama (dalam menit)
ISOLAR_STALE_AFTER_MINUTES=15

# Izinkan sync otomatis saat read dashboard (default: false, disarankan false di prod)
SYNC_FALLBACK_ON_READ=false

# Escape hatch untuk tombol "Sync Now" manual TANPA login (mis. endpoint lama
# yang belum tercakup middleware auth). Sejak login 2-akun aktif (lihat bagian
# AUTENTIKASI di bawah), user yang sudah login otomatis boleh pakai Sync Now -
# flag ini seharusnya TETAP 'false' di operasional normal.
# Sinkronisasi otomatis (scheduler/cron CRON_SECRET) TIDAK terpengaruh oleh flag ini.
ALLOW_MANUAL_SYNC=false

# ------------------------------------------------------------------------------
# 4. SERVER SCHEDULER & CRON SECURITY (Runtime)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk melindungi route POST /api/cron/isolar-sync
# Header pemanggil: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4b. AUTENTIKASI LOGIN (2 akun tetap: admin & valens) - WAJIB diisi
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani cookie sesi login. WAJIB diisi string acak
# panjang (mis. hasil `openssl rand -hex 32`) dan berbeda antar environment.
# Mengubah nilai ini akan membuat semua sesi login yang sedang aktif logout paksa.
AUTH_SESSION_SECRET=

# Username login (bebas, tidak harus "admin"/"valens" persis)
AUTH_ADMIN_USERNAME=admin
AUTH_VALENS_USERNAME=valens

# Nama tampilan di header/profil (opsional, ada default jika dikosongkan)
AUTH_ADMIN_DISPLAY_NAME=Admin
AUTH_VALENS_DISPLAY_NAME=Valens Aditya T.

# Hash password (BUKAN password polos). Generate dengan:
#   node scripts/hash-password.mjs "password_rahasia_kamu"
# lalu salin hasilnya (format "salt:hash") ke sini. Jangan pernah commit
# password asli atau taruh di chat - cukup hasil hash-nya.
AUTH_ADMIN_PASSWORD_HASH=
AUTH_VALENS_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# 5. CLIENT / FRONTEND CONFIGURATION (Dibutuhkan saat Build & Runtime)
# ------------------------------------------------------------------------------
# Mengaktifkan notifikasi alarm foreground di antarmuka web
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=true

# Mode output build Next.js (diset 'standalone' untuk container Docker)
NEXT_OUTPUT_MODE=standalone
